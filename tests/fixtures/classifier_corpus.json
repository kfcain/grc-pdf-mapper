{
  "version": "2026-08-05.5",
  "policy": [
    {
      "id": "policy-must-mfa",
      "text": "All privileged accounts must use multi-factor authentication.",
      "kind": "obligation",
      "strength": "must",
      "domains": ["access_control"]
    },
    {
      "id": "policy-shall-logging",
      "text": "Authentication logs shall be sent to the SIEM.",
      "kind": "obligation",
      "strength": "shall",
      "domains": ["access_control", "logging"]
    },
    {
      "id": "policy-prohibition",
      "text": "Encryption secrets must not be stored in source code.",
      "kind": "prohibition",
      "strength": "prohibited",
      "action_polarity": "negative",
      "domains": ["encryption"]
    },
    {
      "id": "policy-recommendation",
      "text": "Vulnerability patches should be applied after each approved scan.",
      "kind": "recommendation",
      "strength": "should",
      "domains": ["vulnerability"]
    },
    {
      "id": "policy-permission",
      "text": "Administrators may request temporary access through the approved workflow.",
      "kind": "permission",
      "strength": "may",
      "domains": ["access_control"]
    },
    {
      "id": "policy-nonnormative-may-cause",
      "text": "System outages may cause delayed access.",
      "extract": false,
      "domains": []
    },
    {
      "id": "policy-nonnormative-may-include",
      "text": "The report may include account statistics.",
      "extract": false,
      "domains": []
    },
    {
      "id": "policy-control-description",
      "text": "The network segmentation control separates production from development.",
      "kind": "control_description",
      "strength": "descriptive",
      "domains": ["network_security"]
    },
    {
      "id": "policy-control-citation",
      "text": "AC-2 defines the account management control.",
      "kind": "citation",
      "strength": "descriptive",
      "domains": ["access_control"]
    },
    {
      "id": "policy-responsibility",
      "text": "Security Operations is responsible for monitoring audit logs.",
      "kind": "responsibility",
      "strength": "must",
      "domains": ["logging"]
    },
    {
      "id": "policy-will-ensure",
      "text": "The security team will ensure that backups are tested.",
      "kind": "obligation",
      "strength": "must",
      "domains": ["backup"]
    },
    {
      "id": "policy-descriptive-can",
      "text": "Users can request access from the service desk.",
      "extract": false,
      "domains": []
    },
    {
      "id": "policy-obligation-waiver",
      "text": "Administrators do not have to use multi-factor authentication.",
      "kind": "permission",
      "strength": "may",
      "domains": ["access_control"]
    },
    {
      "id": "policy-nonnormative-may-not",
      "text": "The service may not be available during maintenance.",
      "extract": false,
      "domains": []
    },
    {
      "id": "policy-normative-may-not",
      "text": "Users may not share access credentials.",
      "kind": "prohibition",
      "strength": "prohibited",
      "domains": ["access_control"]
    },
    {
      "id": "policy-first-may-later-must",
