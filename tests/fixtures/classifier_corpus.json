      "kind": "obligation",
      "strength": "must",
      "domains": ["logging"]
    },
    {
      "id": "policy-nonnormative-cannot",
      "text": "Legacy devices cannot support multi-factor authentication.",
      "extract": false,
      "domains": []
    },
    {
